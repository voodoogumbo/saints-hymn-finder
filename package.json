{
  "name": "saints-hymn-finder",
  "version": "2.0.0",
  "description": "Hymn numbers and titles from the hymnbooks of The Church of Jesus Christ of Latter-day Saints in English, Spanish, French, Portuguese, Tongan and Samoan",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./en": "./languages/en/hymns.json",
    "./es": "./languages/es/himnos.json",
    "./fr": "./languages/fr/cantiques.json",
    "./pt": "./languages/pt/hinos.json",
    "./to": "./languages/to/himi.json",
    "./sm": "./languages/sm/viiga.json",
    "./crosswalk": "./crosswalk.json",
    "./languages/*": "./languages/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "crosswalk.json",
    "languages/**/*.json"
  ],
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voodoogumbo/saints-hymn-finder.git"
  },
  "keywords": [
    "lds",
    "latter-day saints",
    "hymns",
    "hymnbook",
    "himnos",
    "cantiques",
    "hinos",
    "church",
    "music",
    "titles",
    "numbers",
    "multilingual",
    "tongan",
    "samoan",
    "ngaahi himi",
    "viiga"
  ],
  "author": "Will Grigoratos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/voodoogumbo/saints-hymn-finder/issues"
  },
  "homepage": "https://voodoogumbo.github.io/saints-hymn-finder/",
  "engines": {
    "node": ">=18"
  }
}
